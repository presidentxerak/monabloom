# ── LLM cascade (the Gardener) ─────────────────────────────────────────────
# Providers are tried in order; only those with a key set are attempted. When
# one runs out of free tokens / rate-limits, the next takes over. All optional.
ANTHROPIC_API_KEY=sk-ant-...
# Free / fast fallbacks (sign up for a key, then set whichever you want):
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# Optional model overrides:
# ANTHROPIC_MODEL=claude-sonnet-4-6
# CEREBRAS_MODEL=llama-3.3-70b
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# MISTRAL_MODEL=mistral-small-latest

# ── Wallet serveur (inscriptions on-chain) ─────────────────────────────────
# Généré via `npm run wallet:new`. NE JAMAIS committer la vraie valeur.
MONAD_SERVER_PRIVATE_KEY=0x...

# ── Réseau Monad TESTNET uniquement ────────────────────────────────────────
# Valeurs publiques par défaut du testnet Monad. Vérifie sur https://docs.monad.xyz.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_EXPLORER_URL=https://testnet.monadexplorer.com

# ── Côté navigateur (The Garden — connexion wallet du joueur) ───────────────
# Exposées au client pour le switch de réseau MetaMask. Mêmes valeurs publiques.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadexplorer.com
