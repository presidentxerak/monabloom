# ── Anthropic (le Jardinier) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Wallet serveur (inscriptions on-chain) ─────────────────────────────────
# Généré via `npm run wallet:new`. NE JAMAIS committer la vraie valeur.
MONAD_SERVER_PRIVATE_KEY=0x...

# ── Réseau Monad TESTNET uniquement ────────────────────────────────────────
# Valeurs publiques par défaut du testnet Monad. Vérifie sur https://docs.monad.xyz.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_EXPLORER_URL=https://testnet.monadexplorer.com
